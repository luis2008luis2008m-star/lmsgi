
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="Página de ejemplo con contenido principal, galería de imágenes e información de interés.">
    <title>Mi página web</title>
</head>
<body>

    <!-- Encabezado y navegación -->
    <header>
        <h1>Mi página web</h1>

        <nav aria-label="Navegación principal">
            <a href="#inicio">Inicio</a>
            <a href="#servicios">Servicios</a>
            <a href="#galeria">Galería</a>
            <a href="#contacto">Contacto</a>
            <button type="button">Iniciar sesión</button>
        </nav>
    </header>

    <!-- Contenido principal -->
    <main>

        <!-- Primera sección -->
        <section id="inicio">
            <h2>Bienvenido a nuestra página</h2>
            <p>
                Descubre nuestros servicios y conoce todo lo que podemos
                ofrecerte a través de nuestra página web.
            </p>
            <button type="button">Más información</button>
        </section>

        <!-- Segunda sección -->
        <section id="servicios">
            <h2>Nuestros servicios</h2>
            <p>
                Explora nuestra galería para conocer algunos de nuestros
                proyectos y servicios destacados.
            </p>

            <!-- Galería de tarjetas -->
            <div class="gallery" id="galeria">

                <div class="card">
                    <img
                        src="imagenes/proyecto1.jpg"
                        alt="Ejemplo del primer proyecto"
                        width="300"
                        height="200"
                        loading="lazy"
                    >
                    <p>Descripción del primer proyecto.</p>
                    <a href="proyecto1.html">Ver proyecto 1</a>
                </div>

                <div class="card">
                    <img
                        src="imagenes/proyecto2.jpg"
                        alt="Ejemplo del segundo proyecto"
                        width="300"
                        height="200"
                        loading="lazy"
                    >
                    <p>Descripción del segundo proyecto.</p>
                    <a href="proyecto2.html">Ver proyecto 2</a>
                </div>

                <div class="card">
                    <img
                        src="imagenes/proyecto3.jpg"
                        alt="Ejemplo del tercer proyecto"
                        width="300"
                        height="200"
                        loading="lazy"
                    >
                    <p>Descripción del tercer proyecto.</p>
                    <a href="proyecto3.html">Ver proyecto 3</a>
                </div>

            </div>
        </section>

    </main>

    <!-- Pie de página -->
    <footer id="contacto">

        <div>
            <h3>Sobre nosotros</h3>
            <p>Quiénes somos.</p>
            <p>Nuestra historia.</p>
            <p>Nuestro equipo.</p>
        </div>

        <div>
            <h3>Servicios</h3>
            <p>Servicio uno.</p>
            <p>Servicio dos.</p>
            <p>Servicio tres.</p>
        </div>

        <div>
            <h3>Recursos</h3>
            <p>Documentación.</p>
            <p>Tutoriales.</p>
            <p>Preguntas frecuentes.</p>
        </div>

        <div>
            <h3>Enlaces de interés</h3>
            <p>Blog.</p>
            <p>Noticias.</p>
            <p>Colaboraciones.</p>
        </div>

        <div>
            <h3>Contacto</h3>
            <p>Correo electrónico.</p>
            <p>Teléfono.</p>
            <p>Dirección.</p>
        </div>

    </footer>

</body>
</html>
